# Horse Annotator — Environment Variables
# Copy this file to .env and adjust values

# Backend port
PORT=8000

# YOLO model path (relative to backend/)
# Options: yolov8n.pt, yolov8s.pt, yolov8m.pt, yolov8l.pt, yolov8x.pt
# Or a custom trained model: models/my_horse_model.pt
YOLO_MODEL_PATH=yolov8n.pt

# Horse detection confidence threshold (0.0 - 1.0)
DETECTION_CONFIDENCE=0.35

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*

# Frontend dev server (for reference)
VITE_API_BASE=http://localhost:8000
